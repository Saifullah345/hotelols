NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the deployed app. Used to build auth email links (signup
# confirmation + customer invites) so they always point at the live site
# instead of localhost. Defaults to https://hotelmanagement.n6solution.com.
# This exact URL must also be added under Supabase → Authentication →
# URL Configuration (Site URL + Redirect URLs), or the verify link falls back
# to Supabase's Site URL (often http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://hotelmanagement.n6solution.com

# Google Maps JavaScript API — used for the hotel details "Location" map.
# Create a key at https://console.cloud.google.com/google/maps-apis, enable
# "Maps JavaScript API", and restrict it to your site's domain(s).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID is optional (Map Styles > Map IDs), only
# needed if you want cloud-based map styling / Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — transactional email (signup verification, password reset, branded emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender — must be an address on a domain you've verified in Resend.
# onboarding@resend.dev only delivers to your own Resend account email (testing).
RESEND_FROM=BookQayam <noreply@bookqayam.com>
# Optional: absolute URL to a logo image for branded emails (falls back to a text logo).
EMAIL_LOGO_URL=
# Optional: override the secret used to sign password-reset code cookies (defaults to the service role key).
OTP_SECRET=

# ── Paddle (subscription billing) ────────────────────────────────────
# All four must come from the SAME Paddle environment. Sandbox keys will not
# work against production and vice versa. NEXT_PUBLIC_* values are inlined at
# build time, so restart the dev server / rebuild after changing them.
#
# sandbox | production — decides which Paddle API and JS environment is used.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication → Client-side tokens.
# Without this, checkout fails with Paddle's generic "Something went wrong".
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle → Developer tools → Authentication → API keys. Server-side only.
# Needed to publish plans to Paddle and to sync a subscription after checkout.
PADDLE_API_KEY=
# Paddle → Developer tools → Notifications → your destination → secret key.
# Without this EVERY webhook is rejected with 401, so renewals, cancellations
# and failed payments never reach the app.
PADDLE_WEBHOOK_SECRET=
# Currency new plan prices are created in (defaults to USD).
PADDLE_CURRENCY=USD
